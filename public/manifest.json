{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "Confluence Toolkit",
  "version": "0.3.0",
  "description": "Search, edit, and audit Confluence. Run Jira tools from the same Chrome extension.",
  "key": "",
  "action": { "default_title": "Confluence Toolkit", "default_popup": "index.html" },
  "background": { "service_worker": "static/js/background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "16": "logo16.png", "48": "logo48.png", "128": "logo128.png" },
  "permissions": ["scripting", "storage", "tabs", "sidePanel", "nativeMessaging"],
  "optional_host_permissions": ["https://*/*"]
}
