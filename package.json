{
  "name": "confluence-toolkit",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && playwright test",
    "test:e2e": "playwright test",
    "install:host": "node scripts/install-host.mjs",
    "mcp": "node bridge/server.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "smoke": "node scripts/smoke.mjs",
    "confluence": "node scripts/confluence.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "domhandler": "^6.0.1",
    "htmlparser2": "^12.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
